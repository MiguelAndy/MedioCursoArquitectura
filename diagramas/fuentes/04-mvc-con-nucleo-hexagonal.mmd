flowchart TB
  subgraph V["V · VISTA"]
    V1["Pantallas nativas Windows y Android (Compose)<br/>+ representaciones del servidor: JSON (DTO) · PDF · XML"]
  end
  subgraph C["C · CONTROLADOR = adaptador primario"]
    C1["Controladores REST · Spring Web MVC<br/>ComprobanteController · ProductoController · MigracionController ...<br/>(interfaces generadas desde el OpenAPI)"]
    C2["Planificador y oyentes de eventos<br/>(también conducen casos de uso)"]
  end
  subgraph M["M · MODELO = núcleo hexagonal (sin dependencias de frameworks en el dominio)"]
    IN["Puertos de entrada · casos de uso<br/>EmitirComprobanteUseCase · AnularComprobanteUseCase · CargarLoteLegadoUseCase ..."]
    SRVA["Servicios de aplicación<br/>transacciones · orquestación · publicación de eventos"]
    DOM["Dominio<br/>Agregados: Comprobante · Serie · Producto · Existencia · LoteMigracion<br/>Servicios: MotorTributario · ValidadorNormativo"]
    OUT["Puertos de salida · interfaces<br/>ComprobanteRepository · NumeradorPort · DocumentoElectronicoPort<br/>CanalEnvioCpePort · ConsultaContribuyentePort · PublicadorEventos"]
  end
  subgraph A["Adaptadores secundarios = infraestructura"]
    A1["JPA / PostgreSQL"]
    A2["UBL 2.1 + XMLDSig"]
    A3["SOAP OSE / SUNAT"]
    A4["Padrón RUC · PDF · correo"]
  end
