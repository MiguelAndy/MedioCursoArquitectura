{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tipos comunes - ABC Comercial",
  "description": "Tipos primitivos reutilizados por todos los contratos. Los formatos numéricos replican la notación de SUNAT (Anexo N.° 9-A): n(12,2) para importes y n(12,10) para valores unitarios y cantidades. Los importes viajan como texto decimal para evitar errores de coma flotante en los clientes Windows/Android.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Ruc": {
      "type": "string",
      "description": "RUC de 11 dígitos. El dígito verificador (módulo 11) se valida en el dominio: regla VAL-ID-02.",
      "pattern": "^(10|15|16|17|20)\\d{9}$",
      "examples": ["20123456786"]
    },
    "Dni": {
      "type": "string",
      "pattern": "^\\d{8}$"
    },
    "NumeroDocumentoIdentidad": {
      "type": "string",
      "description": "an..15 según el Anexo N.° 9-A. Para el adquirente no identificado se usa el valor configurado en SUP-08.",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[A-Za-z0-9-]{1,15}$"
    },
    "Fecha": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "Hora": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
      "description": "hh:mm:ss (cbc:IssueTime)"
    },
    "FechaHora": {
      "type": "string",
      "format": "date-time"
    },
    "Periodo": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Periodo tributario YYYY-MM."
    },
    "Importe": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,2})?$",
      "description": "Importe n(12,2) no negativo, en la moneda del comprobante.",
      "examples": ["1500.00"]
    },
    "ImporteConSigno": {
      "type": "string",
      "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
      "description": "Importe n(12,2) que admite signo (p. ej., el redondeo del importe total)."
    },
    "ValorUnitario": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,10})?$",
      "description": "n(12,10): valor o precio unitario con hasta 10 decimales."
    },
    "Cantidad": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,10})?$",
      "description": "n(12,10): cantidad mayor que cero (VAL-ITM-02)."
    },
    "Porcentaje": {
      "type": "string",
      "pattern": "^\\d{1,3}(\\.\\d{1,5})?$",
      "description": "n(3,5): tasa expresada en porcentaje, p. ej. '18.00'."
    },
    "TipoCambio": {
      "type": "string",
      "pattern": "^\\d{1,4}\\.\\d{3}$",
      "description": "Tipo de cambio con 3 decimales (Registro de Ventas, Formato 14.1)."
    },
    "Ubigeo": {
      "type": "string",
      "pattern": "^\\d{6}$",
      "description": "Código de ubigeo del INEI (Catálogo N.° 13)."
    },
    "CodigoEstablecimiento": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "Código del domicilio fiscal ('0000') o del establecimiento anexo declarado en el RUC (cbc:AddressTypeCode)."
    },
    "Serie": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}$",
      "description": "Serie alfanumérica de 4 caracteres. La letra inicial depende del tipo de comprobante (VAL-NUM-01)."
    },
    "Correlativo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999
    },
    "NumeroComprobante": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}-\\d{1,8}$",
      "description": "<Serie>-<Número> sin ceros a la izquierda, p. ej. F001-1 (cbc:ID)."
    },
    "Texto100": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "Texto500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "RazonSocial": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "description": "an..1500 (cbc:RegistrationName)."
    },
    "Correo": {
      "type": "string",
      "format": "email",
      "maxLength": 150
    },
    "Enlaces": {
      "type": "object",
      "description": "Hipervínculos relativos a recursos relacionados.",
      "additionalProperties": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "Auditoria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creadoPor", "creadoEn"],
      "properties": {
        "creadoPor": { "type": "string" },
        "creadoEn": { "$ref": "#/$defs/FechaHora" },
        "modificadoPor": { "type": "string" },
        "modificadoEn": { "$ref": "#/$defs/FechaHora" },
        "puntoEmisionId": { "type": "string" },
        "correlationId": { "type": "string" }
      }
    },
    "PaginaMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pagina", "tamano", "totalElementos"],
      "properties": {
        "pagina": { "type": "integer", "minimum": 0 },
        "tamano": { "type": "integer", "minimum": 1, "maximum": 200 },
        "totalElementos": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
