{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comunicación de baja (RA) y resumen diario (RC)",
  "description": "Documentos de envío asíncrono a SUNAT/OSE mediante sendSummary + getStatus. Las facturas y sus notas se anulan con comunicación de baja; las boletas y sus notas, con el resumen diario (estado 3). Ver VAL-BAJ-*.",
  "$defs": {
    "ComunicacionBajaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentos"],
      "properties": {
        "documentos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comprobanteId", "motivo"],
            "properties": {
              "comprobanteId": { "$ref": "comun.schema.json#/$defs/Uuid" },
              "motivo": { "type": "string", "minLength": 3, "maxLength": 100 }
            }
          }
        }
      }
    },
    "EstadoResumen": {
      "type": "string",
      "enum": ["GENERADO", "ENVIADO", "EN_PROCESO", "ACEPTADO", "RECHAZADO", "EXCEPCION"]
    },
    "ComunicacionBaja": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identificador", "fechaGeneracion", "fechaEmisionDocumentos", "estado", "documentos"],
      "properties": {
        "id": { "$ref": "comun.schema.json#/$defs/Uuid" },
        "identificador": { "type": "string", "pattern": "^RA-\\d{8}-\\d{1,5}$", "examples": ["RA-20261023-1"] },
        "fechaGeneracion": { "$ref": "comun.schema.json#/$defs/Fecha" },
        "fechaEmisionDocumentos": { "$ref": "comun.schema.json#/$defs/Fecha" },
        "estado": { "$ref": "#/$defs/EstadoResumen" },
        "ticket": { "type": "string" },
        "documentos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipoComprobante", "numero", "motivo"],
            "properties": {
              "tipoComprobante": { "$ref": "catalogos-sunat.schema.json#/$defs/Cat01ComprobanteEmitible" },
              "numero": { "$ref": "comun.schema.json#/$defs/NumeroComprobante" },
              "motivo": { "type": "string" }
            }
          }
        },
        "respuestaSunat": { "$ref": "comprobante.response.schema.json#/$defs/RespuestaSunat" }
      }
    },
    "GenerarResumenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fechaEmisionDocumentos"],
      "properties": {
        "fechaEmisionDocumentos": { "$ref": "comun.schema.json#/$defs/Fecha" }
      }
    },
    "ResumenDiario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identificador", "fechaGeneracion", "fechaEmisionDocumentos", "estado", "lineas"],
      "properties": {
        "id": { "$ref": "comun.schema.json#/$defs/Uuid" },
        "identificador": { "type": "string", "pattern": "^RC-\\d{8}-\\d{1,5}$", "examples": ["RC-20261022-1"] },
        "fechaGeneracion": { "$ref": "comun.schema.json#/$defs/Fecha" },
        "fechaEmisionDocumentos": { "$ref": "comun.schema.json#/$defs/Fecha" },
        "estado": { "$ref": "#/$defs/EstadoResumen" },
        "ticket": { "type": "string" },
        "lineas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipoComprobante", "numero", "estadoItem", "importeTotal"],
            "properties": {
              "tipoComprobante": { "type": "string", "enum": ["03", "07", "08"] },
              "numero": { "$ref": "comun.schema.json#/$defs/NumeroComprobante" },
              "estadoItem": {
                "type": "string",
                "oneOf": [
                  { "const": "1", "title": "Adicionar (Catálogo N.° 19)" },
                  { "const": "2", "title": "Modificar" },
                  { "const": "3", "title": "Anulado" }
                ]
              },
              "importeTotal": { "$ref": "comun.schema.json#/$defs/Importe" }
            }
          }
        },
        "respuestaSunat": { "$ref": "comprobante.response.schema.json#/$defs/RespuestaSunat" }
      }
    }
  }
}
